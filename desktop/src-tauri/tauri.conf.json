{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Raffronto",
  "version": "0.1.0",
  "identifier": "cloud.16bit.raffronto",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/prepare-web.mjs",
    "beforeBuildCommand": "node scripts/prepare-web.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Raffronto",
        "width": 1440,
        "height": 900,
        "minWidth": 820,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 30 },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Confronta due versioni di un documento Word o PDF",
    "longDescription": "Confronta due versioni di un documento Word o PDF e vedi affiancate tutte le differenze, pagina per pagina. I file restano sul tuo computer.",
    "copyright": "© 2026 16bit",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
